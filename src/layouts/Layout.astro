---
const { title = 'Antonio Oyuela | Técnico Informático' } = Astro.props;
---
<!doctype html>
<html lang="es">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="description" content="Currículum de Antonio Oyuela: sistemas, redes, soporte técnico y desarrollo web.">
<title>{title}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
<style is:global>
:root{font-family:'DM Sans',sans-serif;color:#eef2ff;background:#101b35}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 85% 0%,#263e78,transparent 34rem),#101b35;min-width:320px}a{color:inherit;text-decoration:none}.container{width:min(1100px,calc(100% - 40px));margin:auto}.muted{color:#aab6d1}.eyebrow{color:#72e6c1;font-size:.75rem;font-weight:700;letter-spacing:.15em;text-transform:uppercase}.section{padding:70px 0;border-top:1px solid #ffffff18}.title{font:700 clamp(1.9rem,4vw,2.5rem) 'Space Grotesk',sans-serif;margin:9px 0 28px}.card{background:#192849d9;border:1px solid #a9b8df2b;border-radius:17px;padding:23px}.pill{display:inline-block;padding:7px 11px;border:1px solid #72e6c14a;background:#72e6c111;color:#b9f7e2;border-radius:30px;font-size:.8rem;margin:4px}.btn{border:1px solid #72e6c1;border-radius:10px;padding:12px 17px;background:#72e6c1;color:#0d1c2d;font-weight:700;cursor:pointer}.btn.alt{background:transparent;color:#eef2ff;border-color:#aab6d155}@media(max-width:700px){.container{width:calc(100% - 28px)}.section{padding:52px 0}}@media print{body{background:#fff!important;color:#172033!important;font-size:9pt}.no-print,nav{display:none!important}.section{padding:20px 0;border-color:#ddd;break-inside:avoid}.card{background:#fff!important;color:#172033;border:1px solid #ddd}.muted{color:#4b5563}.eyebrow,.accent{color:#08785a}.pill{color:#155e4b;background:#effcf7;border-color:#9bdac7}.hero{padding:25px 0!important}}
</style>
</head><body><slot /></body></html>
