    "550 horas · 2023",
    "Formación y prácticas relacionadas con la reparación de ordenadores.",
  ],
  [
    "Seguridad Informática",
    "90 horas · 2025",
    "Formación en seguridad de sistemas informáticos.",
  ],
  [
    "Programación Orientada a Objetos y Bases de Datos",
    "150 horas · 2025",
    "Formación en programación y bases de datos.",
  ],
  [
