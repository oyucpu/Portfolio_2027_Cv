  "CSS",
  "SASS",
  "Bootstrap",
  "Ofimática",
];
const studies = [
  [
    "Grado Medio en Sistemas Microinformáticos y Redes",
    "2009–2014",
    "Formación profesional en sistemas microinformáticos y redes.",
  ],
  [
    "Sistemas Microinformáticos",
    "560 horas · 2014–2015",
    "Formación técnica en sistemas microinformáticos.",
  ],
  [
    "Operaciones de Sistemas Informáticos",
