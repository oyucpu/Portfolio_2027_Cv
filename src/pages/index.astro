    "2025",
    "Formación complementaria en tareas administrativas.",
  ],
];
const courses = [
  "Iniciación a la creación de páginas web · 2020",
  "Web 2.0 y Redes Sociales · 2018",
  "Active Directory y Nuevas Tecnologías · 2018",
  "AutoCAD y PowerShell · 2018",
  "Ofimática · 2017",
  "Adobe Photoshop y SketchUp · 2016–2017",
];
const creative = [
  "Grado Superior de Artes Gráficas – Diseño y Edición de Publicaciones Impresas y Multimedia · 2026–Actualidad",
  "Desarrollo de Aplicaciones con Tecnologías Web · 590 horas · 2023–2024",
  "Confección y Publicación de Páginas Web · 490 horas · 2023–2024",
  "Montaje y Postproducción de Audiovisuales · 510 horas · 2024",
  "Operaciones de Grabación y Tratamiento de Datos y Documentos · 470 horas · 2025",
  "Ilustración · 750 horas · 2021–2022",
  "Desarrollo de Productos Editoriales Multimedia · 570 horas · 2021",
  "Grado Medio de Artes Gráficas – Preimpresión Digital · 2015–2017",
];
const projects = [
  [
    "01",
    "Montaje y mantenimiento",
    "Conocimientos de montaje, reparación y puesta a punto de ordenadores y sistemas microinformáticos.",
    ["Hardware", "Mantenimiento", "Windows"],
  ],
  [
    "02",
    "Sistemas y redes",
    "Formación en redes departamentales y sistemas de comunicaciones de voz y datos.",
    ["Redes", "Voz y datos", "Sistemas"],
  ],
  [
    "03",
    "Desarrollo web",
    "Creación de páginas web y aplicaciones utilizando tecnologías web y herramientas frontend.",
    ["HTML", "CSS", "SASS", "Bootstrap"],
